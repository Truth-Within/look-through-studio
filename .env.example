# Copy to .env and fill in what you have. --demo needs nothing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

TTS_VOICE=en-US-GuyNeural
TTS_RATE=-5%

FPS=24
OUTPUT_DIR=output
YT_PRIVACY=private

# Batch mode
TIMEZONE=Africa/Kampala
PUBLISH_TIME=18:00
QUEUE_FILE=queue.json
